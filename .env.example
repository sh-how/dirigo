# Without these settings Dirigo serves the sample dashboard only.

# Public address of the app, used for the GitHub callback and same-origin checks.
APP_URL=http://localhost:5180
PORT=8787
NODE_ENV=development

# Postgres
DATABASE_URL=postgres://dirigo:dirigo@localhost:5432/dirigo

# The GitHub App (read-only permissions; see README.md)
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# The app's private key, with line breaks written as \n
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# 32 random bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep it outside the database, in a secrets manager in production.
TOKEN_ENCRYPTION_KEY=

# Optional
# RECONCILE_CRON=*/15 * * * *
# UNWATCHED_GRACE_DAYS=7
# ACCESS_CHECK_MINUTES=10
# RUN_WORKERS=false

{
  "name": "dirigo",
  "version": "0.1.0",
  "private": true,
  "description": "Reads the GitHub repositories you contribute to and tells you what is blocked, what needs your decision, and whether you will ship on time.",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n server,client -c green,blue \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsc -p tsconfig.server.json --outDir dist/dev-server && concurrently -r \"tsc -w --preserveWatchOutput -p tsconfig.server.json --outDir dist/dev-server\" \"node --env-file-if-exists=.env --watch-path=dist/dev-server dist/dev-server/server/main.js --port 8787\"",
    "dev:client": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build && tsc -p tsconfig.server.json",
    "start": "node dist/server/server/main.js",
    "worker": "node dist/server/server/worker-main.js",
    "migrate": "node --env-file-if-exists=.env dist/server/server/db/migrate.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource/instrument-sans": "^5.3.0",
    "@hono/node-server": "^2.1.7",
    "@octokit/auth-app": "^8.3.1",
    "@octokit/graphql": "^9.0.5",
    "@octokit/request": "^10.0.16",
    "@octokit/webhooks-methods": "^6.0.0",
    "@tanstack/react-query": "^5.107.1",
    "hono": "^4.13.18",
    "pg": "^8.23.1",
    "pg-boss": "^12.38.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^29.1.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
